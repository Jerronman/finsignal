# --- Marketaux (news source) ---
# Free plan: 100 requests/day. POLL_INTERVAL_SECONDS below defaults to 900s
# (15 min) = 96 calls/day, leaving headroom for restarts + test script runs.
MARKETAUX_API_TOKEN=
MARKETAUX_BASE_URL=https://api.marketaux.com/v1
NEWS_LIMIT=10
NEWS_LANGUAGE=en

# --- Alpaca paper trading ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# --- Anthropic (signal engine judging each news item) ---
ANTHROPIC_API_KEY=
SIGNAL_MODEL=claude-haiku-4-5

# --- Trading behavior knobs (news-driven) ---
POLL_INTERVAL_SECONDS=900
MIN_CONFIDENCE=0.6
MIN_TRADE_USD=200
MAX_TRADE_USD=1000
COOLDOWN_MINUTES=60

# --- Take-profit (independent of news; only calls Alpaca) ---
# Tiered profit-taking based on gain since YOUR entry price. Format:
# "threshold:fraction,...". Each tier sells that fraction of the ORIGINAL
# share count once crossed -- default: up 5% -> sell 25% of original;
# up 10% -> another 25% (50% sold total); up 20% -> another 25% (75%
# sold); up 50% -> sell whatever's left (100% sold). See the Strategy tab
# in the app for the live, human-readable version of whatever's set here.
TAKE_PROFIT_ENABLED=true
TAKE_PROFIT_TIERS=5:0.25,10:0.25,20:0.25,50:0.25
TAKE_PROFIT_CHECK_INTERVAL_SECONDS=120

DB_PATH=finsignal.db

# --- Access control ---
# Leave both blank for local dev (no login prompt). Set both once this is
# hosted anywhere reachable off your own machine -- one shared
# username/password for everyone you give the link to.
APP_USERNAME=
APP_PASSWORD=
